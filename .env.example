# Offline demo (default): deterministic judge, no API key, no network.
PTM_OFFLINE=1

# Real judge via the Common AI provider. Set OFFLINE=0 and supply a
# pydantic-ai connection. The provider supports 20+ vendors behind this one
# connection, so switching model vendor never touches the DAG code.
# PTM_OFFLINE=0
# AIRFLOW_CONN_PYDANTICAI_DEFAULT='{"conn_type":"pydanticai","host":"anthropic:claude-sonnet-5","password":"sk-ant-..."}'

# Priced, not selected. This names the model the cost ledger and the backfill
# forecast should quote; the model actually used comes from the connection
# above. Keep the two in step or the forecast is confidently wrong.
# PTM_JUDGE_MODEL=anthropic:claude-sonnet-5

# Override the price list in ptm/cost.py, as input/output USD per million
# tokens. Useful when the built-in table has gone stale.
# PTM_PRICE=3.00/15.00

# The verdict cache, on by default. Keyed on the hash of the prompt and the
# model, so any change to the policy, the case or the instructions misses.
# Set 0 to stop *reading* it - usually because you no longer trust an entry -
# without also throwing away the run you are paying for right now. The
# stability DAG never reads it in either setting; see ptm/cache.py for why.
# PTM_CACHE=0

# Mixed into every cache key, to invalidate the cache deliberately. The key
# covers everything this project controls - the policy, the case, the
# rendering, the model identifier - and cannot cover the one thing it does not:
# a vendor changing what sits behind an unchanged model name. Bump this and no
# earlier answer is found again. Unlike PTM_CACHE=0 it does not keep writing
# into a keyspace you have stopped trusting, and unlike deleting the table it
# leaves the old entries readable.
# PTM_CACHE_EPOCH=2026-09-after-the-model-upgrade

# A second, independent judge. Self-consistency (ptm/stability.py) is satisfied
# completely by a judge that misreads a clause the same way every time; two
# judges misreading it the same way is a far smaller coincidence. Set this on a
# judge_stability run and the same connection is used with the model overridden,
# so no second connection is needed:
#
#   airflow dags trigger judge_stability_expenses \
#     --conf '{"compare_model":"anthropic:claude-haiku-4-5"}'
#
# Cases the two judges split on are cases the policy does not settle. There is
# no offline stand-in - it would be one rule set answering twice.
